<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_strip_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingTop="6dp"
    android:paddingRight="8dp"
    android:paddingBottom="6dp">

    <!-- Top mini header: Location & Next prayer info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/strip_widget_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Jakarta Pusat"
            android:textColor="#A7F3D0"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/strip_widget_next_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menuju Ashar 15:10"
            android:textColor="#FDE047"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5 Complete Prayer Times Horizontal Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Subuh -->
        <LinearLayout
            android:id="@+id/strip_box_subuh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/strip_label_subuh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subuh"
                android:textColor="#94A3B8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/strip_time_subuh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04:25"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dzuhur -->
        <LinearLayout
            android:id="@+id/strip_box_dzuhur"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/strip_label_dzuhur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dzuhur"
                android:textColor="#94A3B8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/strip_time_dzuhur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11:50"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Ashar -->
        <LinearLayout
            android:id="@+id/strip_box_ashar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/strip_label_ashar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ashar"
                android:textColor="#94A3B8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/strip_time_ashar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15:10"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/strip_box_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/strip_label_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maghrib"
                android:textColor="#94A3B8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/strip_time_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18:02"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Isya -->
        <LinearLayout
            android:id="@+id/strip_box_isya"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/strip_label_isya"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Isya"
                android:textColor="#94A3B8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/strip_time_isya"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19:15"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
